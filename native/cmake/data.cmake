# Game data formats (namespace baroque::data): ACT, PRM, TLK, EVT, EXI, AISEQ, font/texture tables.
# Tables under data/tables/*.inc and checks/data_expected.inc are generated by tools/gen_tables.py.
set(BAROQUE_DATA_SOURCES
  ${CMAKE_CURRENT_SOURCE_DIR}/data/common.cpp
  ${CMAKE_CURRENT_SOURCE_DIR}/data/act.cpp
  ${CMAKE_CURRENT_SOURCE_DIR}/data/prm.cpp
  ${CMAKE_CURRENT_SOURCE_DIR}/data/tlk.cpp
  ${CMAKE_CURRENT_SOURCE_DIR}/data/evt.cpp
  ${CMAKE_CURRENT_SOURCE_DIR}/data/evt_jptime.cpp
  ${CMAKE_CURRENT_SOURCE_DIR}/data/exi.cpp
  ${CMAKE_CURRENT_SOURCE_DIR}/data/aiseq.cpp
  ${CMAKE_CURRENT_SOURCE_DIR}/data/text_tables.cpp)
target_sources(Baroque-Native PRIVATE ${BAROQUE_DATA_SOURCES})

# Standalone checker: parses every ACT/PRM/TLK/EVT file plus BQ.EXI and AISEQ.BIN under the asset root and
# compares counts/histograms with work/game_formats_summary.json (via the generated checks/data_expected.inc).
add_executable(Baroque-DataCheck
  ${CMAKE_CURRENT_SOURCE_DIR}/checks/data_check_main.cpp
  ${CMAKE_CURRENT_SOURCE_DIR}/platform/platform.cpp
  ${BAROQUE_DATA_SOURCES})
target_include_directories(Baroque-DataCheck PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}")
target_link_libraries(Baroque-DataCheck PRIVATE raylib)
target_compile_definitions(Baroque-DataCheck PRIVATE BAROQUE_ASSET_ROOT="${CMAKE_CURRENT_SOURCE_DIR}/../work/assets")
if(MSVC)
  target_compile_options(Baroque-DataCheck PRIVATE /W4 /O2 /utf-8)
endif()
