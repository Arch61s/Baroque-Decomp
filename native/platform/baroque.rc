// PORT (packaging): Windows resources of Baroque-Native - icon (tools/make_icon.py, from the title logo) + version.
// GLFW_ICON is the name GLFW looks up for the window / taskbar icon; Explorer uses the same (first) icon group.
#include <winver.h>
#ifndef BAROQUE_VERSION_MAJOR
#define BAROQUE_VERSION_MAJOR 0
#define BAROQUE_VERSION_MINOR 1
#define BAROQUE_VERSION_PATCH 0
#define BAROQUE_VERSION_STRING "0.1.0"
#endif

#ifdef BAROQUE_HAS_ICON
GLFW_ICON ICON "baroque.ico"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION BAROQUE_VERSION_MAJOR, BAROQUE_VERSION_MINOR, BAROQUE_VERSION_PATCH, 0
 PRODUCTVERSION BAROQUE_VERSION_MAJOR, BAROQUE_VERSION_MINOR, BAROQUE_VERSION_PATCH, 0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Baroque native port project"
            VALUE "FileDescription", "Baroque (native PC port)"
            VALUE "FileVersion", BAROQUE_VERSION_STRING
            VALUE "InternalName", "Baroque"
            VALUE "OriginalFilename", "Baroque.exe"
            VALUE "ProductName", "Baroque native port"
            VALUE "ProductVersion", BAROQUE_VERSION_STRING
            VALUE "Comments", "Fan port. Requires the player's own Baroque (USA) PS2 disc image; no game data included."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
